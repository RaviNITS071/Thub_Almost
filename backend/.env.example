# ==============================================================================
# TenderHub Backend Environment Variables (Production & Development)
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=8000

# MongoDB Database Connection URL
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/tenderhub?retryWrites=true&w=majority

# Upstash or Local Redis URL (used for rate limiting & token revocation)
REDIS_URL=redis://default:<password>@<host>:6379

# JWT Token Secrets (Use strong random strings: `openssl rand -hex 32`)
JWT_ACCESS_SECRET=your_jwt_access_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Frontend Base URL & CORS Settings
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# Google OAuth 2.0 / OpenID Connect (Backend Only - Never expose to frontend!)
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback

# ------------------------------------------------------------------------------
# Transactional Email Provider (Free Tier: Resend / Brevo / SMTP)
# ------------------------------------------------------------------------------
# Resend free tier: 3,000 emails/mo. Sign up at https://resend.com
EMAIL_PROVIDER=resend
EMAIL_FROM=TenderHub <no-reply@tenderhub.in>
EMAIL_API_KEY=re_your_resend_api_key_here

# ------------------------------------------------------------------------------
# Optional AI & Storage
# ------------------------------------------------------------------------------
# Google Gemini (Free tier with generous limits: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Hugging Face Router Vision (Free serverless router: https://huggingface.co/settings/tokens)
HF_TOKEN=your_huggingface_token_here
HF_MODEL=zai-org/GLM-4.5V

# Cloudflare R2 Object Storage
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=tenderhub

# ------------------------------------------------------------------------------
# Telegram Bot Notifications (100% Free - Get from @BotFather)
# ------------------------------------------------------------------------------
# Create bot with @BotFather on Telegram to get token:
TELEGRAM_BOT_TOKEN=
# Get your numeric chat ID from @userinfobot or https://api.telegram.org/bot<TOKEN>/getUpdates:
TELEGRAM_CHAT_ID=

