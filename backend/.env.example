# ==============================================================================
# TenderHub Backend Environment Variables (Production & Development)
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=8000

# MongoDB Database Connection URL
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/tenderhub?retryWrites=true&w=majority

# Upstash or Local Redis URL (used for rate limiting & token revocation)
REDIS_URL=redis://default:<password>@<host>:6379

# JWT Token Secrets (Use strong random strings: `openssl rand -hex 32`)
JWT_ACCESS_SECRET=your_jwt_access_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Frontend Base URL & CORS Settings
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# Google OAuth 2.0 / OpenID Connect (Backend Only - Never expose to frontend!)
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback

# ------------------------------------------------------------------------------
# Transactional Email Provider (Free Tier: Resend / Brevo / SMTP)
# ------------------------------------------------------------------------------
# Resend free tier: 3,000 emails/mo. Sign up at https://resend.com
EMAIL_PROVIDER=resend
EMAIL_FROM=TenderHub <no-reply@tenderhub.in>
EMAIL_API_KEY=re_your_resend_api_key_here

# ------------------------------------------------------------------------------
# Optional AI & Storage
# ------------------------------------------------------------------------------
OPENAI_API_KEY=dummy_key
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=tenderhub
